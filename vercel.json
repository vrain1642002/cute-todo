{
    "version": 2,
    "builds": [
        {
            "src": "build/web/index.html",
            "use": "@vercel/static"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/build/web/index.html"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/build/web/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "require-corp"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        }
    ]
}